# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# SECURITY: Copy this to .env and fill in with secure values
# DO NOT commit .env file to version control
# Generate secrets using: openssl rand -base64 32
# =============================================================================

# Django Settings
DJANGO_ENV=production
SECRET_KEY=CHANGEME_GENERATE_WITH_openssl_rand_base64_64
DEBUG=False
ALLOWED_HOSTS=your-domain.com,your-ip-address,localhost
CORS_ALLOWED_ORIGINS=http://your-domain.com:3000,https://your-domain.com

# Database Configuration
DB_NAME=transaction_monitor
DB_USER=postgres
DB_PASSWORD=CHANGEME_GENERATE_WITH_openssl_rand_hex_32
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGEME_GENERATE_WITH_openssl_rand_hex_16

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Rust Risk Scorer
RUST_RISK_SCORER_URL=http://rust-scorer:8001
RUST_RISK_SCORER_ENABLED=true
RUST_LOG=info

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME_GENERATE_WITH_openssl_rand_base64_16
GRAFANA_ROOT_URL=http://your-ip-or-domain:3000
PROMETHEUS_PORT=9090

# Gunicorn Settings
GUNICORN_WORKERS=4

# Build Environment
BUILD_ENV=production

# Optional: Service Ports (defaults shown)
# BACKEND_PORT=8000
# GRAFANA_PORT=3000
# DB_PORT=5433
